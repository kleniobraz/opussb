[Unit]
Description=OpusSB Flask Job Server
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/opussb
EnvironmentFile=/opt/opussb/.env
# Loopback para o Nginx, gateway do Docker para o N8N. NUNCA 0.0.0.0:
# 0.0.0.0 expoe o Flask direto na internet (porta 5001) e pula o Basic Auth.
ExecStart=/opt/opussb/venv/bin/gunicorn \
    --workers 1 \
    --threads 4 \
    --bind 127.0.0.1:5001 \
    --bind 172.17.0.1:5001 \
    --timeout 3600 \
    app:app
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=opussb

[Install]
WantedBy=multi-user.target
