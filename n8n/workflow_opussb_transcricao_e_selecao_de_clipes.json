      "parameters": {
        "jsCode": "const raw = $input.first().json.content[0].text;\nconst match = raw.match(/\\[[\\s\\S]*\\]/);\nif (!match) throw new Error('Claude não retornou JSON válido: ' + raw.substring(0, 200));\nconst clips_json = match[0];\nJSON.parse(clips_json);\n\nreturn [{\n  json: {\n    clips_json: clips_json,\n    transcript: $('Build Claude Body').first().json.transcript,\n    job_id: $('Build Claude Body').first().json.job_id\n  }\n}];"
